# Virtual environment
.venv/
venv/
env/

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg
*.egg-info/
dist/
build/
eggs/
.eggs/
.ruff_cache/
.pytest_cache/

# Environment and logs
.env
.env.*
!apps/web/.env.production
!apps/web/.env.development
*.log

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Node / pnpm
node_modules/
apps/*/node_modules/
dist/
*.tsbuildinfo

# Cloudflare Wrangler
.wrangler/

# Playwright
apps/web/playwright-report/
apps/web/test-results/
apps/web/.playwright/

# Data. The pipeline database, bulletin PDFs and run outputs live in R2 and
# are pulled on demand (`pnpm data:pull`); only curated inputs are committed.
data/bulletins/
data/*.db
data/*.db-*
data/*.db.bak
data/runs/
data/out/
data/legacy/

# Generated frontend assets (the snapshot is published data: `pnpm data:pull`)
apps/web/public/frontend.snapshot
apps/web/public/frontend.snapshot.previous
apps/web/public/*.wasm

# Claude Code. The shared session-start hook and its registration are tracked;
# everything else under .claude/ (local settings, caches) stays local.
.claude/*
!.claude/settings.json
!.claude/hooks/

# Ad-hoc UI benchmark runs (`pnpm --filter web perf --save <name>`). The two
# reference runs recorded when the harness landed stay tracked.
apps/web/perf/results/*.json
!apps/web/perf/results/baseline.json
!apps/web/perf/results/optimized.json
