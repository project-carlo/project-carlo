# Virtual environment
.venv/
venv/
env/

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg
*.egg-info/
dist/
build/
eggs/
.eggs/
.ruff_cache/
.pytest_cache/

# Environment and logs
.env
.env.*
!apps/web/.env.production
!apps/web/.env.development
*.log

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Node / pnpm
node_modules/
apps/*/node_modules/
dist/
*.tsbuildinfo

# Cloudflare Wrangler
.wrangler/

# Playwright
apps/web/playwright-report/
apps/web/test-results/
apps/web/.playwright/

# Data. The pipeline database, bulletin PDFs and run outputs live in R2 and
# are pulled on demand (`pnpm data:pull`); only curated inputs are committed.
data/bulletins/
data/*.db
data/*.db-*
data/*.db.bak
# Run outputs and the result cache stay local, except eval results
# (data/runs/<classifier>/eval/: predictions, run.json, report.md/.json),
# which are committed so runs can be compared over time.
data/runs/*
!data/runs/*/
data/runs/*/*
!data/runs/*/eval/
data/out/
data/pipeline/
# PDFs and page images `pnpm seed pdf|pages` write for the seeding agent to read.
# Seed files (data/seeds/) and test runs (data/seed-evals/) are committed.
data/seed-work/
scratch/
# `pnpm label --demo` builds its generated dataset here. Real labels
# (data/labels/) are committed.
data/labeler-demo/

# Generated frontend assets (the snapshot is published data: `pnpm data:pull`)
apps/web/public/frontend.json.gz
apps/web/public/frontend.json.gz.previous

# Claude Code. The shared session-start hook, its registration and the project
# skills are tracked; everything else under .claude/ (local settings, caches)
# stays local.
.claude/*
!.claude/settings.json
!.claude/hooks/
!.claude/skills/

# Ad-hoc UI benchmark runs (`pnpm --filter web perf --save <name>`). The two
# reference runs recorded when the harness landed stay tracked.
apps/web/perf/results/*.json
!apps/web/perf/results/baseline.json
!apps/web/perf/results/optimized.json
