{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "WebWorker"],
    "types": [],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "skipLibCheck": true,
    "isolatedModules": true,
    "noEmit": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true
  },
  "include": [
    "worker",
    "src/lib/approximateLocationApi.ts",
    "src/lib/analyticsApi.ts",
    "src/lib/analyticsReports.ts",
    "src/lib/accessAuth.ts"
  ]
}
