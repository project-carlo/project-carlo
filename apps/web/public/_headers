/frontend.json.gz
  Content-Type: application/octet-stream
  Cache-Control: public, no-cache, must-revalidate
  X-Content-Type-Options: nosniff

# Page dates for the next build's sitemap (scripts/prerender.ts); never a
# search result, and always fresh so a build never compares against a stale copy.
/lastmod.json
  Cache-Control: public, no-cache, must-revalidate
  X-Robots-Tag: noindex
