{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "project-carlo",
  "compatibility_date": "2026-03-01",
  "observability": {
    "enabled": true,
  },
  "preview_urls": true,
  "main": "worker/index.ts",
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
  "compatibility_flags": ["nodejs_compat"],
}
