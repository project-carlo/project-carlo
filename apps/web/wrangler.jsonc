{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "project-carlo",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-03-01",
  // Cost guards. The Worker only answers /api/* and asset misses, and does
  // microseconds of work each time, so these caps sit far above what it
  // needs; they're there so a bug gets killed instead of billing for
  // runaway CPU or fan-out.
  "limits": {
    // Per invocation. The Paid plan's default is 30s; this matches the Free
    // plan's ceiling.
    "cpu_ms": 10,
    // fetch() calls per invocation (the ASSETS binding passthrough is the
    // only one today). The Paid plan's default is 10,000.
    "subrequests": 5,
  },
  "observability": {
    "enabled": true,
    // Workers Logs bill per event past the plan's allowance; one in ten
    // invocations is plenty to spot errors.
    "head_sampling_rate": 0.1,
  },
  "preview_urls": true,
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Static files and page navigations (the SPA shell) never run the
    // Worker; /api/* always does, and so does any other request no file
    // matches (worker/index.ts hands those back to the assets).
    "run_worker_first": ["/api/*"],
  },
  "compatibility_flags": ["nodejs_compat"],
}
