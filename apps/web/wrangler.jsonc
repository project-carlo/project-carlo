{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "project-carlo",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-03-01",
  // Cost guards. No "limits" block: the account is on Workers Free, which
  // refuses one (API error 100328, even for "subrequests" alone) and already
  // fixes each invocation at 10ms of CPU and 50 subrequests, with 100,000
  // requests a day for the whole account. On moving to Paid, where the
  // defaults are 30s of CPU and 10,000 subrequests, add:
  //   "limits": { "cpu_ms": 10, "subrequests": 5 },
  // The Worker does microseconds of work and at most one fetch (the ASSETS
  // passthrough), so those caps only ever stop a bug.
  "observability": {
    "enabled": true,
    // Workers Logs bill per event past the plan's allowance; one in ten
    // invocations is plenty to spot errors.
    "head_sampling_rate": 0.1,
  },
  "preview_urls": true,
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Static files and page navigations (the SPA shell) never run the
    // Worker; /api/* always does, and so does any other request no file
    // matches (worker/index.ts hands those back to the assets).
    "run_worker_first": ["/api/*"],
  },
  "compatibility_flags": ["nodejs_compat"],
}
