{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "project-carlo",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-03-01",
  // Cost guards. No "limits" block: the account is on Workers Free, which
  // refuses one (API error 100328, even for "subrequests" alone) and already
  // fixes each invocation at 10ms of CPU and 50 subrequests, with 100,000
  // requests a day for the whole account. On moving to Paid, where the
  // defaults are 30s of CPU and 10,000 subrequests, add:
  //   "limits": { "cpu_ms": 10, "subrequests": 15 },
  // The Worker does microseconds of work and at most one fetch (the ASSETS
  // passthrough), except the analytics dashboard's endpoint, which makes up
  // to 13 (Access's keys and 11 queries; docs/analytics.md). So those caps
  // only ever stop a bug.
  "observability": {
    "enabled": true,
    // Workers Logs bill per event past the plan's allowance; one in ten
    // invocations is plenty to spot errors.
    "head_sampling_rate": 0.1,
  },
  // Visitor analytics (worker/index.ts, docs/analytics.md). The dataset is
  // created on the first write. Workers Free includes 100,000 data points a
  // day, one per event; the browser batches a page's events into a single
  // request, so each page costs one Worker invocation. Preview versions write
  // here too, tagged with their own host.
  "analytics_engine_datasets": [
    { "binding": "ANALYTICS", "dataset": "project_carlo_events" },
  ],
  "preview_urls": true,
  "assets": {
    "binding": "ASSETS",
    // A URL no file matches gets 404.html with a 404 status, not the SPA
    // shell with a 200, so search engines see real 404s (closed churches,
    // typos) instead of soft ones. Every client-rendered route therefore
    // needs its own copy of the shell: scripts/prerender.ts writes those.
    "not_found_handling": "404-page",
    // Static files never run the Worker; /api/* always does, and so does
    // any other request no file matches (worker/index.ts hands those back
    // to the assets, which answer with 404.html).
    "run_worker_first": ["/api/*"],
  },
  "compatibility_flags": ["nodejs_compat"],
}
