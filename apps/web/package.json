{
  "name": "web",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@10.12.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "pnpm run build:ts && pnpm run build:vite && pnpm run build:prerender",
    "build:ts": "tsc -b",
    "build:vite": "vite build",
    "build:prerender": "tsx --tsconfig tsconfig.app.json scripts/prerender.ts",
    "carry-assets": "tsx --tsconfig tsconfig.app.json scripts/carry-assets.ts",
    "og:gen": "tsx scripts/generate-og.ts",
    "geocode:cities": "tsx --tsconfig tsconfig.app.json scripts/geocode-cities.ts",
    "analytics": "tsx --tsconfig tsconfig.app.json scripts/analytics-report.ts",
    "preview": "pnpm run build && wrangler dev",
    "lint": "eslint .",
    "check": "tsc -b",
    "test": "vitest run",
    "deploy": "pnpm run build && wrangler deploy",
    "test:e2e": "playwright test",
    "perf": "node perf/bench.mjs",
    "perf:compare": "node perf/compare.mjs",
    "perf:profile": "node perf/profile.mjs",
    "test:e2e:install": "playwright install --with-deps chromium"
  },
  "dependencies": {
    "@fontsource-variable/eb-garamond": "^5.3.0",
    "@fontsource/cardo": "^5.3.0",
    "@tanstack/react-query": "^5.104.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "fuse.js": "^7.5.0",
    "leaflet": "^1.9.4",
    "radix-ui": "^1.8.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.63.1",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.64.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^16.5.0",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^7.3.7",
    "vitest": "^4.1.11",
    "wrangler": "^4.149.0"
  }
}
