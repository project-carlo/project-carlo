{
  "name": "mobile",
  "private": true,
  "version": "0.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "build:android": "nice -n 19 expo run:android --no-bundler; status=$?; ./android/gradlew -p android --stop >/dev/null 2>&1; exit $status",
    "device": "node scripts/device.mjs",
    "e2e": "maestro test .maestro --test-output-dir .maestro/output",
    "lint": "expo lint",
    "check": "tsc --noEmit",
    "doctor": "pnpm dlx expo-doctor",
    "export": "expo export --platform all --output-dir dist"
  },
  "dependencies": {
    "@carlo/core": "workspace:*",
    "expo": "~58.0.22",
    "expo-constants": "~58.0.14",
    "expo-dev-client": "~58.0.18",
    "expo-font": "~58.0.11",
    "expo-linking": "~58.0.15",
    "expo-router": "~58.0.29",
    "expo-splash-screen": "~58.0.12",
    "expo-status-bar": "~58.0.4",
    "expo-system-ui": "~58.0.7",
    "expo-web-browser": "~58.0.7",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.1",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~58.0.4",
    "typescript": "~6.0.3"
  }
}
